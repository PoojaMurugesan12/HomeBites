{
  "name": "homebites",
  "version": "1.0.0",
  "private": true,
  "description": "HomeBites - Cloud Kitchen Growth & Intelligence Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/dist/index.js",
    "dev": "npm run db:ensure && tsx scripts/dev.ts",
    "dev:server": "npm run db:ensure && npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "db:ensure": "tsx scripts/db-manager.ts start",
    "db:stop": "tsx scripts/db-manager.ts stop",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "build": "npm run db:generate && npm --workspace=server run build && npm --workspace=client run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7"
  }
}
