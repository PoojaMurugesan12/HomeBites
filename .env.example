# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# For local zero-config, embedded PostgreSQL runs automatically on port 5433:
DATABASE_URL="postgresql://postgres:password@localhost:5433/homebites_dev?schema=public"
# Or provide your external PostgreSQL connection string:
# DATABASE_URL="postgresql://username:password@localhost:5432/homebites?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret-for-production-min-32-chars"
SESSION_COOKIE_NAME="homebites_session"
COOKIE_SECURE=false

# Embedded Postgres Port (default: 5433)
EMBEDDED_PG_PORT=5433
